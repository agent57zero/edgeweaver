<?xml version="1.0" encoding="UTF-8"?>
<!-- DARK / UNREGISTERED: definition only (birth run B7, per D28). Not imported into Task
     Scheduler until B8 arming: registering this task is what puts Alpha's channel session
     under supervision, so it arms WITH the channel, never before. Enabled=false so an
     accidental import lands disabled. Mirrors Genesis's 15-minute channel watchdog; the
     script itself launches the session if absent (that is the launcher path at B8). -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Edgeweaver Alpha Telegram channel watchdog: relaunch the channel session if down, notify Alan on the ops line.</Description>
    <URI>\Edgeweaver\EdgeweaverAlphaChannelWatchdog</URI>
  </RegistrationInfo>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <Repetition>
        <Interval>PT15M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <Enabled>false</Enabled>
    <WakeToRun>false</WakeToRun>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File "C:\Users\agent\Project\Edgeweaver\scripts\ops\alpha-channel-watchdog.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
