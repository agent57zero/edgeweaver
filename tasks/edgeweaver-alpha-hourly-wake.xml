<?xml version="1.0" encoding="UTF-8"?>
<!-- D41, the hours: Edgeweaver Alpha hourly waking, LIVE from 2026-08-20 at Alan's
     instruction (twin parity with Genesis, G20). Ticks at :40 past every hour,
     staggered from Genesis's :10; the launcher guards the consolidation hour, a
     still-running night loop, and a busy room. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Edgeweaver Alpha hourly waking (the hours, D41), every hour at :40.</Description>
    <URI>\Edgeweaver\EdgeweaverAlphaHourlyWake</URI>
  </RegistrationInfo>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2026-08-20T00:40:00</StartBoundary>
      <Enabled>true</Enabled>
      <Repetition>
        <Interval>PT1H</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <Enabled>true</Enabled>
    <WakeToRun>true</WakeToRun>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT20M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File C:\Users\agent\Project\Edgeweaver\scripts\waking\run-hourly-alpha.ps1</Arguments>
    </Exec>
  </Actions>
</Task>
