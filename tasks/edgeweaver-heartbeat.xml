<?xml version="1.0" encoding="UTF-8"?>
<!-- DARK / UNREGISTERED: definition only (PREBUILD A2, dark rule 1). Arms at Phase 3 + G5.
     Fallback heartbeat wake every 3h (checklist 03 waking policy: "fallback /loop 3h or schtasks
     equivalent"). WakeToRun mandatory on this-PC hosting. Enabled=false so an accidental import
     lands disabled. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Edgeweaver fallback heartbeat wake (waking policy) every 3 hours.</Description>
    <URI>\Edgeweaver\EdgeweaverHeartbeat</URI>
  </RegistrationInfo>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <Repetition>
        <Interval>PT3H</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <Enabled>false</Enabled>
    <WakeToRun>true</WakeToRun>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -Command "Set-Location 'C:\Users\agent\Project\Edgeweaver'; claude -p '/wake-edgeweaver' --output-format text *&gt;&gt; logs\heartbeat.log"</Arguments>
    </Exec>
  </Actions>
</Task>
