{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/fishbowl", "destination": "/fishbowl.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ,{ "key": "Cache-Control", "value": "private, no-store" }
        ,{ "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
        ,{ "key": "Referrer-Policy", "value": "no-referrer" }
        ,{ "key": "X-Content-Type-Options", "value": "nosniff" }
        ,{ "key": "X-Frame-Options", "value": "DENY" }
        ,{ "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" }
      ]
    },
    {
      "source": "/(fishbowl|fishbowl.html|api/fishbowl|assets/fishbowl.css|assets/fishbowl.js|media/.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "all" }
        ,{ "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    }
  ]
}
