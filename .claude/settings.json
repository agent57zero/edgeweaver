{
  "model": "claude-fable-5",
  "effortLevel": "medium",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".prompt // empty\" | grep -qiE \"\\\"write[^\\\"]{0,20}read[^\\\"]{0,10}\\\"\" && echo \"Alan sent the write-back shorthand. Run the FULL write-back now: 1-3 episodes covering the day so far, any candidate lessons (pending, never self-confirmed), then embed-backfill, then PROVE the read-back by recalling today through the scoped wrapper. Report the proof to Alan via the reply tool.\" || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "C:\\Users\\agent\\Project\\edgeweaver-soul",
      "C:\\Users\\agent\\Project\\edgeweaver-alpha-soul"
    ],
    "allow": [
      "Bash(*)",
      "Read(//c/Users/agent/Project/edgeweaver-soul/**)",
      "Read(//c/Users/agent/Project/edgeweaver-alpha-soul/**)",
      "Read(//c/Users/agent/.claude/channels/telegram/access.json)",
      "Read(//c/Users/agent/.claude/channels/telegram-alpha/access.json)",
      "Edit(//c/Users/agent/Project/edgeweaver-alpha-soul/**)",
      "Write(//c/Users/agent/Project/edgeweaver-alpha-soul/**)",
      "mcp__plugin_telegram_telegram__reply",
      "mcp__plugin_telegram_telegram__react",
      "mcp__plugin_telegram_telegram__edit_message"
    ]
  }
}
