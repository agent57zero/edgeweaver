# Secrets and local config
.env
.env.*
*.local
.claude/settings.local.json

# Corpus downloads (redistributable but bulky — fetch scripts are committed instead)
corpus/

# Daemon state (operational memory, never identity)
state/
avatars/genesis/soul-source/*.json
logs/

# OS noise
.DS_Store
Thumbs.db

# Future tooling
node_modules/
__pycache__/
*.pyc

# Supabase CLI local state (function SOURCES are committed; only CLI state is ignored)
supabase/.temp/

# D46: mirrored room media is deploy-time content, regenerated by scripts/ops/fishbowl-media.mjs;
# personal photos/voice never enter git history (they are served live by Vercel from the deploy)
tools/alpha-dashboard/public/media/
tools/genesis-dashboard/public/media/
